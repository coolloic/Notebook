# Required — OpenAI powers both the chat model and the embeddings
OPENAI_API_KEY=sk-...

# Optional — enable LangSmith tracing to see every step of the agent loop
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key

# Optional overrides (defaults shown)
CHAT_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small
CHROMA_DIR=./chroma_db
